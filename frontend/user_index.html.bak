<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/x-icon" href="images/tomshead.ico">
  <title>Project Developments Dashboard</title>
  <style>
    :root {
      --bg: #0f172a;
      --card: #111827;
      --muted: #94a3b8;
      --text: #e5e7eb;
      --accent: #38bdf8;
      --success: #22c55e;
      --warning: #f59e0b;
      --danger: #ef4444;
      --bar-bg: #1f2937;
      --bar-fill: #60a5fa;
      --shadow: 0 8px 24px rgba(0,0,0,0.35);
      --radius: 14px;
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Segoe UI Emoji", "Segoe UI Symbol";
      background: radial-gradient(1200px 600px at 20% 0%, #0b122a 0%, var(--bg) 60%, #0a1023 100%);
      color: var(--text);
    }

    header {
      padding: 40px 24px 20px;
      display: grid;
      gap: 10px;
      max-width: 1120px;
      margin: 0 auto;
    }
    .auth-actions {
      max-width: 1120px;
      margin: 0 auto;
      padding: 24px 24px 0;
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      justify-content: center;
    }
    .auth-message {
      margin: 0;
      font-size: 1rem;
      font-weight: 600;
      color: var(--text);
      text-align: center;
    }
    .welcome-banner {
      max-width: 1120px;
      margin: 0 auto;
      padding: 14px 16px;
      border-radius: 12px;
      border: 1px solid #1f2937;
      background: rgba(34, 197, 94, 0.15);
      color: #bbf7d0;
      font-weight: 600;
      letter-spacing: 0.2px;
      display: none;
    }
    .welcome-banner.active {
      display: block;
    }
    .project-switcher {
      max-width: 1120px;
      margin: 0 auto;
      padding: 0 24px 24px;
      display: grid;
      gap: 8px;
    }
    .project-switcher .switcher-row {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 12px;
      align-items: center;
    }
    .project-switcher .switcher-row .btn {
      min-width: 160px;
      justify-self: start;
    }
    @media (max-width: 640px) {
      .project-switcher .switcher-row { grid-template-columns: 1fr; }
    }
    .project-switcher .helper {
      margin: 0;
      font-size: 0.85rem;
      color: var(--muted);
    }
    .section-picker {
      margin-top: 12px;
      padding: 16px;
      border-radius: var(--radius);
      border: 1px solid #1f2937;
      background: rgba(15, 23, 42, 0.9);
      box-shadow: var(--shadow);
      display: grid;
      gap: 14px;
    }
    .section-picker[hidden] { display: none; }
    .section-picker__header {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }
    .section-picker__title {
      margin: 0;
      font-size: 1rem;
    }
    .section-picker__helper {
      margin: 4px 0 0;
      color: var(--muted);
      font-size: 0.85rem;
    }
    .section-picker__list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 10px;
    }
    .section-picker__item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 12px;
      border-radius: 10px;
      border: 1px solid #1f2937;
      background: #0b1325;
      gap: 14px;
    }
    .section-picker__label {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 600;
    }
    .section-picker__meta {
      color: var(--muted);
      font-size: 0.85rem;
    }
    .section-picker__actions {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
      flex-wrap: wrap;
    }
    .check {
      width: 18px;
      height: 18px;
      border-radius: 4px;
      border: 1px solid #1f2937;
      appearance: none;
      background: #0b1325;
      position: relative;
    }
    .check:checked {
      background: var(--accent);
      border-color: var(--accent);
    }
    .check:checked::after {
      content: '';
      position: absolute;
      inset: 4px;
      border: 2px solid #0b1325;
      border-top: none;
      border-right: none;
      transform: rotate(-45deg);
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .title-row {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .edit-title {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 1px solid #1f2937;
      background: #0b1325;
      color: var(--text);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 6px 18px rgba(0,0,0,0.25);
    }
    .edit-title svg {
      width: 16px;
      height: 16px;
      fill: currentColor;
    }
    .inline-title-editor {
      margin-top: 12px;
      display: none;
      gap: 10px;
    }
    .inline-title-editor.active {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto auto;
    }
    @media (max-width: 640px) {
      .inline-title-editor.active {
        grid-template-columns: 1fr;
      }
    }
    .logo {
      width: 52px; height: 52px;
      object-fit: contain;
      flex-shrink: 0;
      display: block;
    }
    h1 { margin: 0; font-size: 1.75rem; letter-spacing: 0.2px; }
    .subtitle { color: var(--muted); font-size: 0.95rem; }

    .toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
      margin-top: 8px;
    }
    .info-trigger { position: relative; }
    .pill {
      background: #0b1325;
      border: 1px solid #1e293b;
      color: var(--muted);
      padding: 8px 12px;
      border-radius: 999px;
      font-size: 0.9rem;
    }
    .btn {
      background: var(--accent);
      color: #062a3a;
      border: none;
      padding: 10px 16px;
      border-radius: 10px;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 6px 18px rgba(56, 189, 248, 0.35);
    }
    .btn:hover {
      opacity: 0.92;
      box-shadow: 0 6px 20px rgba(56, 189, 248, 0.42);
    }
    .btn.secondary {
      background: #0b1325;
      color: var(--text);
      border: 1px solid #1f2937;
      box-shadow: 0 6px 18px rgba(0,0,0,0.25);
    }
    .btn:active { transform: translateY(1px); }

    .info-menu {
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      width: 220px;
      padding: 8px;
      border-radius: 12px;
      border: 1px solid #1f2937;
      background: #0b1325;
      box-shadow: var(--shadow);
      display: grid;
      gap: 6px;
      z-index: 10;
    }
    .info-menu[hidden] { display: none; }
    .info-menu button {
      border: 1px solid transparent;
      background: transparent;
      color: var(--text);
      border-radius: 8px;
      padding: 10px 12px;
      text-align: left;
      cursor: pointer;
    }
    .info-menu button:hover {
      border-color: #1f2937;
      background: rgba(56, 189, 248, 0.08);
    }

    main {
      max-width: 1120px;
      margin: 0 auto;
      padding: 20px 24px 60px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 16px;
    }
    @media (max-width: 960px) {
      .grid { grid-template-columns: repeat(6, 1fr); }
    }
    @media (max-width: 640px) {
      .grid { grid-template-columns: repeat(1, 1fr); }
    }

    .page-actions {
      max-width: 1120px;
      margin: 40px auto 0;
      padding: 0 24px 60px;
      display: flex;
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
    }
    @media (max-width: 640px) {
      .page-actions {
        margin-top: 32px;
        gap: 12px;
      }
      .page-actions .btn {
        flex: 1 1 100%;
        min-height: 48px;
        font-size: 1rem;
      }
    }

    .empty-state {
      max-width: 1120px;
      margin: 24px auto 0;
      padding: 24px;
      border-radius: var(--radius);
      border: 1px dashed #1f2937;
      background: rgba(11, 19, 37, 0.8);
      text-align: center;
      color: var(--muted);
    }
    .empty-state__actions {
      margin-top: 16px;
      display: flex;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .card {
      grid-column: span 4;
      background: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01)), var(--card);
      border: 1px solid #1f2937;
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 18px;
      display: grid;
      gap: 14px;
      position: relative;
      overflow: hidden;
    }

    .card header {
      padding: 0;
      margin: 0;
      display: flex; align-items: center; justify-content: space-between;
    }
    .card-title-wrap {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .card-icon {
      width: 34px;
      height: 34px;
      border-radius: 9px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .card-icon svg { width: 18px; height: 18px; fill: currentColor; }
    .card-icon--electrical   { background: rgba(251, 191, 36, 0.12);  color: #fbbf24; }
    .card-icon--architectural{ background: rgba(167, 139, 250, 0.12); color: #a78bfa; }
    .card-icon--mechanical   { background: rgba(52,  211, 153, 0.12); color: #34d399; }
    .card-icon--plumbing     { background: rgba(56,  189, 248, 0.12); color: #38bdf8; }
    .card-icon--electronics  { background: rgba(251, 113, 133, 0.12); color: #fb7185; }
    .card-icon--general      { background: rgba(99,  102, 241, 0.12); color: #818cf8; }
    .card-icon--others       { background: rgba(148, 163, 184, 0.12); color: #94a3b8; }
    .title {
      font-weight: 700; letter-spacing: 0.2px; font-size: 1rem;
    }
    .status {
      font-size: 0.8rem;
      padding: 6px 10px;
      border-radius: 999px;
      border: 1px solid #1f2937;
    }
    .status.ontrack { background: rgba(34, 197, 94, 0.12); color: var(--success); }
    .status.atrisk  { background: rgba(245, 158, 11, 0.12); color: var(--warning); }
    .status.delayed { background: rgba(239, 68, 68, 0.12); color: var(--danger); }

    .meta {
      display: flex; gap: 14px; color: var(--muted); font-size: 0.9rem;
    }

    .progress-wrap { display: grid; gap: 8px; }
    .progress-bar {
      height: 11px;
      background: var(--bar-bg);
      border-radius: 999px;
      overflow: hidden;
      border: 1px solid #1f2937;
    }
    .progress-fill {
      height: 100%;
      width: 0%;
      border-radius: 999px;
      background: linear-gradient(90deg, #60a5fa, #22d3ee);
      transition: width 500ms ease;
    }
    .progress-value {
      display: flex; justify-content: space-between; align-items: baseline;
      font-size: 0.95rem;
    }
    .progress-value .percent { font-weight: 800; color: #93c5fd; }
    .progress-value .label   { color: var(--muted); }

    .controls {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 8px;
      align-items: center;
    }
    .controls.single { grid-template-columns: auto; justify-content: flex-end; }
    .input {
      width: 100%;
      padding: 10px 12px;
      background: #0b1325;
      color: var(--text);
      border: 1px solid #1f2937;
      border-radius: 10px;
      outline: none;
    }
    .select {
      width: 100%;
      padding: 10px 12px;
      background: #0b1325;
      color: var(--text);
      border: 1px solid #1f2937;
      border-radius: 10px;
      font-size: 0.95rem;
    }
    .footnote { color: var(--muted); font-size: 0.85rem; }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      border: 0;
    }
    .card[hidden] { display: none !important; }
    .card::after {
      content: "";
      position: absolute; inset: -80px -80px auto auto;
      width: 220px; height: 220px;
      background: radial-gradient(120px 120px at 50% 50%, rgba(56,189,248,0.18), transparent 70%);
      transform: rotate(15deg);
      pointer-events: none;
    }

    @media print {
      @page { margin: 0; }
      body {
        background: #fff !important;
        color: #0f172a !important;
        padding: 12mm 10mm !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
      #agyRbacTopbar,
      #agyChangePwdModal,
      #agyToastContainer,
      .no-print,
      body > header,
      .page-header,
      .auth-actions,
      .welcome-banner,
      .project-switcher,
      .controls,
      footer {
        display: none !important;
        visibility: hidden !important;
        height: 0 !important;
        overflow: hidden !important;
      }
      main {
        max-width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
      }
      .card {
        background: #fff !important;
        color: #0f172a !important;
        border: 1px solid #cbd5e1 !important;
        box-shadow: none !important;
        break-inside: avoid;
      }
      .card::after { display: none !important; }
      .title, .percent, .subitem-title, .subitem-value { color: #0f172a !important; }
      .desc, .footnote, .subitems-header, .overview-label { color: #475569 !important; }
    }
  </style>
</head>
<body>
  <div class="auth-actions" role="region" aria-label="Active user message">
    <p class="auth-message" id="pageTime">Today is —</p>
    <p class="auth-message" id="activeUserMessage"> — Project Tracker Dashboard</p>
  </div>
  <div class="welcome-banner" id="welcomeBanner" role="status" aria-live="polite" hidden></div>
  <div class="project-switcher" role="region" aria-label="Saved projects">
    <div class="switcher-row">
      <label class="sr-only" for="projectSelect">Saved projects</label>
      <button class="btn secondary" id="sectionPickerToggle" aria-expanded="false" aria-controls="sectionPicker">Project Selection</button>
      <select class="select" id="projectSelect" aria-label="Saved projects"></select>
    </div>
    <div class="switcher-row">
      <label class="sr-only" for="newProjectInput">New project title</label>
      <button class="btn" id="createProject">Create New Project</button>
      <input class="input" type="text" id="newProjectInput" placeholder="Input Project Name" autocomplete="off" />
    </div>
    <p class="helper">Choose which sections to include in upcoming projects using Project Selection.</p>
    <div class="section-picker" id="sectionPicker" hidden role="region" aria-label="Select sections">
      <div class="section-picker__header">
        <div>
          <p class="section-picker__title">Include Sections</p>
          <p class="section-picker__helper">Toggle sections below; checked entries become part of the next saved project.</p>
        </div>
        <button class="btn secondary" id="resetSections" type="button">Reset List</button>
      </div>
      <ul class="section-picker__list" id="sectionPickerList"></ul>
      <div class="section-picker__actions">
        <button class="btn secondary" id="closeSectionPicker" type="button">Close</button>
      </div>
    </div>
  </div>
  <header>
    <div class="brand">
      <img class="logo" src="images/project_tracker_25p.png" alt="Project Tracker logo" width="52" height="52" />
      <div>
        <div class="title-row">
          <h1 id="projectTitle">Project Developments</h1>
          <button class="edit-title" id="editTitleBtn" aria-label="Edit project name" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm2.92.83l-.83-.83 9.19-9.19.83.83-9.19 9.19zM20.71 7.04a1 1 0 000-1.41l-2.34-2.34a1 1 0 00-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
            </svg>
          </button>
        </div>
        <form class="inline-title-editor" id="titleForm">
          <label class="sr-only" for="titleInput">Project Title</label>
          <input class="input" id="titleInput" type="text" placeholder="Edit current project title" autocomplete="off" />
          <button class="btn" type="submit">Save</button>
          <button class="btn secondary" type="button" id="cancelTitleEdit">Cancel</button>
        </form>
        <div class="subtitle">Live % completeness for key disciplines</div>
      </div>
    </div>
    <div class="toolbar">
      <span class="pill">Project Tracker: v1.0.1</span>
      <span class="pill">Last update: <span id="lastUpdate">—</span></span>
      <label class="pill" style="display:inline-flex;align-items:center;gap:8px;">
        <span>Status:</span>
        <select id="projectStatusSelect" style="background:#0f172a;color:#38bdf8;border:1px solid #334155;border-radius:6px;padding:3px 8px;font-weight:700;font-size:0.82rem;cursor:pointer;">
          <option value="not_started">Not Started</option>
          <option value="in_progress">In Progress</option>
          <option value="on_hold">On Hold</option>
          <option value="completed">Completed</option>
        </select>
      </label>
      <div class="info-trigger">
        <button class="btn secondary" id="projectInfoToggle" aria-expanded="false" aria-controls="projectInfoMenu">Project Info</button>
        <div class="info-menu" id="projectInfoMenu" hidden></div>
      </div>
      <!-- Remove this button already have this Change password button in the header -->
      <!-- <button class="btn secondary" id="changePasswordBtn" type="button">🔑 Change Password</button> -->
      <button class="btn secondary" id="adminPortalBtn" type="button" hidden style="border-color:rgba(167,139,250,0.45);color:#c4b5fd;">🛡️ Admin &amp; Users</button>
      <button class="btn secondary" id="backToOverview">Back to Overview</button>
      <!-- Remove this button -->
      <!-- <button class="btn secondary" id="logoutBtn">Logout</button> -->
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-top:6px;padding:12px 14px;background:rgba(15,23,42,0.75);border:1px solid #1e293b;border-radius:12px;">
      <span style="font-size:0.82rem;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:0.05em;">Portfolio Filter:</span>
      <input class="input" id="projectSearchInput" type="search" placeholder="Search projects by name..." style="max-width:240px;padding:7px 11px;font-size:0.85rem;" />
      <select class="select" id="projectFilterStatus" style="max-width:180px;padding:7px 11px;font-size:0.85rem;">
        <option value="all">All Statuses</option>
        <option value="not_started">Not Started</option>
        <option value="in_progress">In Progress</option>
        <option value="on_hold">On Hold</option>
        <option value="completed">Completed</option>
      </select>
      <span id="projectFilterCount" style="font-size:0.82rem;color:#94a3b8;margin-left:auto;"></span>
    </div>
  </header>

  <main>
    <section class="grid" id="cards">
      <article class="card" data-key="electrical">
        <header>
          <div class="card-title-wrap">
            <div class="card-icon card-icon--electrical" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M7 2v11h3v9l7-12h-4l4-8z"/></svg>
            </div>
            <div class="title">Electrical</div>
          </div>
          <div class="status" id="status-electrical">—</div>
        </header>
        <div class="meta">
          <span>Lead: E-Team</span>
          <span>Scope: Lighting, Power and Controls</span>
        </div>
        <div class="progress-wrap">
          <div class="progress-value">
            <span class="label">Completeness</span>
            <span class="percent" id="percent-electrical">0%</span>
          </div>
          <div class="progress-bar" aria-label="Electrical progress">
            <div class="progress-fill" id="bar-electrical"></div>
          </div>
        </div>
        <div class="controls single">
          <button class="btn secondary" data-open="electrical">Open Section</button>
        </div>
        <div class="footnote">Panelboards, lighting fixtures, and addressable LED rollout status.</div>
      </article>

      <article class="card" data-key="architectural">
        <header>
          <div class="card-title-wrap">
            <div class="card-icon card-icon--architectural" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
            </div>
            <div class="title">Architectural</div>
          </div>
          <div class="status" id="status-architectural">—</div>
        </header>
        <div class="meta">
          <span>Lead: A-Team</span>
          <span>Scope: Envelope, Interiors, Finishes</span>
        </div>
        <div class="progress-wrap">
          <div class="progress-value">
            <span class="label">Completeness</span>
            <span class="percent" id="percent-architectural">0%</span>
          </div>
          <div class="progress-bar" aria-label="Architectural progress">
            <div class="progress-fill" id="bar-architectural"></div>
          </div>
        </div>
        <div class="controls single">
          <button class="btn secondary" data-open="architectural">Open Section</button>
        </div>
        <div class="footnote">Envelope systems, interior fit-out, and public realm deliverables.</div>
      </article>

      <article class="card" data-key="mechanical">
        <header>
          <div class="card-title-wrap">
            <div class="card-icon card-icon--mechanical" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M19.14 12.94c.04-.3.06-.61.06-.94s-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/></svg>
            </div>
            <div class="title">Mechanical</div>
          </div>
          <div class="status" id="status-mechanical">—</div>
        </header>
        <div class="meta">
          <span>Lead: M-Team</span>
          <span>Scope: HVAC, Plumbing, Fire Protection</span>
        </div>
        <div class="progress-wrap">
          <div class="progress-value">
            <span class="label">Completeness</span>
            <span class="percent" id="percent-mechanical">0%</span>
          </div>
          <div class="progress-bar" aria-label="Mechanical progress">
            <div class="progress-fill" id="bar-mechanical"></div>
          </div>
        </div>
        <div class="controls single">
          <button class="btn secondary" data-open="mechanical">Open Section</button>
        </div>
        <div class="footnote">Air systems, hydronics, suppression, and automation metrics.</div>
      </article>
      
      <article class="card" data-key="plumbing">
        <header>
          <div class="card-title-wrap">
            <div class="card-icon card-icon--plumbing" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z"/></svg>
            </div>
            <div class="title">Plumbing</div>
          </div>
          <div class="status" id="status-plumbing">—</div>
        </header>
        <div class="meta">
          <span>Lead: P-Team</span>
          <span>Scope: Pipes, Fixtures, Valves</span>
        </div>
        <div class="progress-wrap">
          <div class="progress-value">
            <span class="label">Completeness</span>
            <span class="percent" id="percent-plumbing">0%</span>
          </div>
          <div class="progress-bar" aria-label="Plumbing progress">
            <div class="progress-fill" id="bar-plumbing"></div>
          </div>
        </div>
        <div class="controls single">
          <button class="btn secondary" data-open="plumbing">Open Section</button>
        </div>
        <div class="footnote">Water supply, drainage, and fixture installations tracked here.</div>
      </article>

      <article class="card" data-key="electronics">
        <header>
          <div class="card-title-wrap">
            <div class="card-icon card-icon--electronics" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M9 10h1v1H9zm0 2h1v1H9zm0 2h1v1H9zm4-4h1v1h-1zm0 2h1v1h-1zm0 2h1v1h-1zm-2-6h1v1h-1zm0 2h1v1h-1zm0 2h1v1h-1zm0 2h1v1h-1zM5 20V4h14v16H5zm2-18C5.9 2 5 2.9 5 4v16c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2H7z"/></svg>
            </div>
            <div class="title">Electronics</div>
          </div>
          <div class="status" id="status-electronics">—</div>
        </header>
        <div class="meta">
          <span>Lead: EL-Team</span>
          <span>Scope: Circuitry, Devices, Controls</span>
        </div>
        <div class="progress-wrap">
          <div class="progress-value">
            <span class="label">Completeness</span>
            <span class="percent" id="percent-electronics">0%</span>
          </div>
          <div class="progress-bar" aria-label="Electronics progress">
            <div class="progress-fill" id="bar-electronics"></div>
          </div>
        </div>
        <div class="controls single">
          <button class="btn secondary" data-open="electronics">Open Section</button>
        </div>
        <div class="footnote">Circuitry, devices, and control systems monitored here.</div>
      </article>

      <article class="card" data-key="general">
        <header>
          <div class="card-title-wrap">
            <div class="card-icon card-icon--general" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M7 2v11h3v9l7-12h-4l4-8z"/></svg>
            </div>
            <div class="title">General</div>
          </div>
          <div class="status" id="status-general">—</div>
        </header>
        <div class="meta">
          <span>Lead: G-Team</span>
          <span>Scope: General project developments and miscellaneous tasks</span>
        </div>
        <div class="progress-wrap">
          <div class="progress-value">
            <span class="label">Completeness</span>
            <span class="percent" id="percent-general">0%</span>
          </div>
          <div class="progress-bar" aria-label="General progress">
            <div class="progress-fill" id="bar-general"></div>
          </div>
        </div>
        <div class="controls single">
          <button class="btn secondary" data-open="general">Open Section</button>
        </div>
        <div class="footnote">General project developments and miscellaneous tasks monitored here.</div>
      </article>

      <article class="card" data-key="others">
        <header>
          <div class="card-title-wrap">
            <div class="card-icon card-icon--others" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M7 2v11h3v9l7-12h-4l4-8z"/></svg>
            </div>
            <div class="title">Others</div>
          </div>
          <div class="status" id="status-others">—</div>
        </header>
        <div class="meta">
          <span>Lead: Others</span>
          <span>Scope: Miscellaneous tasks and other developments</span>
        </div>
        <div class="progress-wrap">
          <div class="progress-value">
            <span class="label">Completeness</span>
            <span class="percent" id="percent-others">0%</span>
          </div>
          <div class="progress-bar" aria-label="Others progress">
            <div class="progress-fill" id="bar-others"></div>
          </div>
        </div>
        <div class="controls single">
          <button class="btn secondary" data-open="others">Open Section</button>
        </div>
        <div class="footnote">Miscellaneous tasks and other developments monitored here.</div>
      </article>

    </section>
    <div class="page-actions">
      <button class="btn" id="viewCompletedProjects">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
        Completed Projects
      </button>
      <button class="btn" id="viewLogs">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14H7v-2h5v2zm5-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
        View Logs
      </button>
      <button class="btn" id="modifyProject">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 000-1.41l-2.34-2.34a1 1 0 00-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
        Modify Project
      </button>
      <button class="btn" id="createGanttChart">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M3 3h2v18H3V3zm4 2h6v4H7V5zm0 6h10v4H7v-4zm0 6h8v4H7v-4z"/></svg>
        Create Gantt Chart
      </button>
      <button class="btn" id="customSectionsBtn">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M4 4h7v7H4V4zm9 0h7v7h-7V4zM4 13h7v7H4v-7zm9 3h3v-3h2v3h3v2h-3v3h-2v-3h-3v-2z"/></svg>
        Custom Sections
      </button>
    </div>
    <section class="empty-state" id="noActiveProjects" hidden>
      <p>Every saved project is already 100% complete. Create a new project to keep tracking work or review final records under Completed Projects.</p>
      <div class="empty-state__actions">
        <button class="btn" id="emptyCompletedProjects" type="button">Completed Projects</button>
      </div>
    </section>
  </main>

  <script src="state.js"></script>
  <!-- Auth Guard -->
  <script>
    if (!window.ProjectData || !window.ProjectData.isAuthenticated()) {
      window.location.href = 'login.html';
    }
  </script>
  <script>
    (function () {
      const {
        SECTION_ORDER,
        SECTION_DEFS,
        isCustomSection,
        getSectionDisplayName,
        loadProjectState,
        persistProjectState,
        fmtDate,
        statusClass,
        getSectionPercent,
        getActiveProject,
        setActiveProject,
        addProject,
        listProjects,
        touchProject,
        isSectionEnabled,
        isProjectCompleted,
        getActiveUserName,
        appendUpdateLog
      } = window.ProjectData;

      const SECTION_MANAGER_ROUTES = {
        electrical: 'e_manage_subitems.html',
        architectural: 'a_manage_subitems.html',
        mechanical: 'm_manage_subitems.html',
        plumbing: 'p_manage_subitems.html',
        electronics: 'el_manage_subitems.html',
        general: 'g_manage_subitems.html',
        others: 'o_manage_subitems.html',
      };

      let state = null;

      const AUTH_KEY = 'projectDashboardAuth';
      const LOGIN_PAGE = 'login.html';
      const WELCOME_KEY = 'projectDashboardWelcomeName';

      const isAuthenticated = () => window.ProjectData && window.ProjectData.isAuthenticated();

      const redirectToLogin = () => {
        console.log('🔄 Redirecting to login page...');
        const target = encodeURIComponent(window.location.href);
        window.location.href = `${LOGIN_PAGE}?redirect=${target}`;
      };

      const ensureAuthenticated = () => {
        const isAuth = isAuthenticated();
        console.log('🔐 ensureAuthenticated result:', isAuth);
        if (isAuth) { return true; }
        redirectToLogin();
        return false;
      };

      const FALLBACK_SECTION_KEYS = ['electrical', 'architectural', 'mechanical', 'plumbing', 'general', 'others'];
      const FALLBACK_METADATA = {
        electrical: {
          title: 'Electrical Section',
          summary: 'Power distribution, lighting, and control scopes.'
        },
        architectural: {
          title: 'Architectural Section',
          summary: 'Envelope, interior finishes, and public realm.'
        },
        mechanical: {
          title: 'Mechanical Section',
          summary: 'HVAC, plumbing, and fire protection packages.'
        },
        plumbing: {
          title: 'Plumbing Section',
          summary: 'Water supply, drainage, and related systems.'
        },
        general: {
          title: 'General Section',
          summary: 'Cross-disciplinary items and overall project health.'
        },
        others: {
          title: 'Other Section',
          summary: 'Additional workstreams that do not fit main categories.'
        },
        custom: {
          title: 'Custom Section',
          summary: 'Custom workstreams require extra setup (coming soon).'
        }
      };

      const dedupeKeys = (list = []) => Array.from(new Set((list || []).filter(Boolean)));
      const getBaseSectionKeys = () => {
        const source = Array.isArray(SECTION_ORDER) && SECTION_ORDER.length
          ? SECTION_ORDER
          : FALLBACK_SECTION_KEYS;
        const sanitized = dedupeKeys(source);
        return sanitized.length ? sanitized : [...FALLBACK_SECTION_KEYS];
      };

      let selectedSections = getBaseSectionKeys();

      const buildPickerEntries = () => {
        const keys = getBaseSectionKeys();
        const entries = keys.map((key) => {
          const definition = SECTION_DEFS && SECTION_DEFS[key];
          const fallback = FALLBACK_METADATA[key];
          const title = definition?.title
            ? getSectionDisplayName(key)
            : fallback?.title || `${key} Section`;
          const summary = definition?.summary || fallback?.summary || 'Track progress for this workstream.';
          return { key, title, summary, disabled: false };
        });

        return entries;
      };

      const enforceSelectionGuard = (entries) => {
        const allowed = entries.filter((entry) => !entry.disabled).map((entry) => entry.key);
        const filtered = dedupeKeys(selectedSections).filter((key) => allowed.includes(key));
        selectedSections = filtered.length ? filtered : [...allowed];
      };

      const handleSectionToggle = (key, checked, checkbox) => {
        if (checked) {
          if (!selectedSections.includes(key)) {
            selectedSections = dedupeKeys([...selectedSections, key]);
          }
          render();
          return;
        }
        if (selectedSections.length === 1) {
          checkbox.checked = true;
          alert('At least one section must remain selected.');
          return;
        }
        selectedSections = selectedSections.filter((value) => value !== key);
        render();
      };

      const renderSectionPicker = () => {
        const list = document.getElementById('sectionPickerList');
        if (!list) { return; }
        const entries = buildPickerEntries();
        enforceSelectionGuard(entries);
        list.innerHTML = entries.map((entry) => {
          const checkboxId = `section-check-${entry.key}`;
          return `
            <li class="section-picker__item">
              <label class="section-picker__label" for="${checkboxId}">
                <input type="checkbox" class="check" id="${checkboxId}" data-section="${entry.key}" ${entry.disabled ? 'disabled' : ''} />
                ${entry.title}
              </label>
              <span class="section-picker__meta">${entry.summary}</span>
            </li>
          `;
        }).join('') + `
            <li class="section-picker__item">
              <a class="section-picker__label" href="custom_sections.html">＋ Create a custom section…</a>
              <span class="section-picker__meta">Add your own section, e.g. Operations or Mechanical Section no.2.</span>
            </li>`;

        entries.forEach((entry) => {
          const checkbox = document.getElementById(`section-check-${entry.key}`);
          if (!checkbox) { return; }
          checkbox.checked = selectedSections.includes(entry.key) && !entry.disabled;
          checkbox.addEventListener('change', () => handleSectionToggle(entry.key, checkbox.checked, checkbox));
        });
      };

      const closeSectionPicker = () => {
        const picker = document.getElementById('sectionPicker');
        const toggle = document.getElementById('sectionPickerToggle');
        if (!picker) { return; }
        if (!picker.hasAttribute('hidden')) {
          picker.setAttribute('hidden', '');
        }
        if (toggle) {
          toggle.setAttribute('aria-expanded', 'false');
        }
      };

      const openSectionPicker = () => {
        const picker = document.getElementById('sectionPicker');
        const toggle = document.getElementById('sectionPickerToggle');
        if (!picker) { return; }
        renderSectionPicker();
        picker.removeAttribute('hidden');
        if (toggle) {
          toggle.setAttribute('aria-expanded', 'true');
        }
      };

      const toggleSectionPicker = () => {
        const picker = document.getElementById('sectionPicker');
        if (!picker) { return; }
        if (picker.hasAttribute('hidden')) {
          openSectionPicker();
        } else {
          closeSectionPicker();
        }
      };

      const getPendingSectionSelection = () => {
        const allowed = new Set(getBaseSectionKeys());
        return dedupeKeys(selectedSections).filter((key) => allowed.has(key));
      };

      const renderInfoMenu = (project, selectionFilter) => {
        const menu = document.getElementById('projectInfoMenu');
        if (!menu) { return; }
        if (!project) {
          menu.innerHTML = '';
          return;
        }
        const allowedKeys = SECTION_ORDER.filter((key) => {
          const enabled = isSectionEnabled(project, key);
          const selectionAllowed = !selectionFilter || selectionFilter.has(key);
          return enabled && selectionAllowed;
        });

        if (!allowedKeys.length) {
          menu.innerHTML = '<button class="menu-item" type="button" disabled>No sections selected</button>';
          return;
        }

        menu.innerHTML = allowedKeys.map((key) => {
          const definition = SECTION_DEFS && SECTION_DEFS[key];
          const label = getSectionDisplayName(key);
          const route = definition?.file || `${key}.html`;
          return `<button class="menu-item" data-route="${route}">${label}</button>`;
        }).join('');
      };

      const computeSelectionFilter = () => {
        const pending = getPendingSectionSelection();
        const base = getBaseSectionKeys();
        if (pending.length === base.length) {
          const baseSet = new Set(base);
          const differs = pending.some((key) => !baseSet.has(key));
          if (!differs) {
            return null;
          }
        }
        return new Set(pending);
      };

      const getEditableProjects = () => listProjects(state)
        .filter((project) => !isProjectCompleted(project));

      const currentProject = () => {
        const active = getActiveProject(state);
        if (active && !isProjectCompleted(active)) {
          return active;
        }
        const fallback = getEditableProjects()[0];
        if (fallback) {
          setActiveProject(state, fallback.id);
          persistProjectState(state);
          return fallback;
        }
        return null;
      };

      let isEditingTitle = false;

      const applyTitleEditorState = () => {
        const form = document.getElementById('titleForm');
        if (form) {
          form.classList.toggle('active', isEditingTitle);
        }
        const editButton = document.getElementById('editTitleBtn');
        if (editButton) {
          editButton.setAttribute('aria-pressed', isEditingTitle ? 'true' : 'false');
        }
      };

      const openTitleEditor = () => {
        isEditingTitle = true;
        applyTitleEditorState();
        const input = document.getElementById('titleInput');
        if (input) {
          window.requestAnimationFrame(() => {
            input.focus();
            input.select();
          });
        }
      };

      const closeTitleEditor = () => {
        isEditingTitle = false;
        applyTitleEditorState();
        const input = document.getElementById('titleInput');
        const project = currentProject();
        if (input && project) {
          input.value = project.title;
        }
      };

      const toggleEmptyState = (hasProject) => {
        const cards = document.getElementById('cards');
        const actions = document.querySelector('.page-actions');
        const emptyState = document.getElementById('noActiveProjects');
        const editButton = document.getElementById('editTitleBtn');
        const infoToggle = document.getElementById('projectInfoToggle');
        if (cards) {
          cards.toggleAttribute('hidden', !hasProject);
        }
        if (actions) {
          actions.toggleAttribute('hidden', !hasProject);
        }
        if (emptyState) {
          emptyState.toggleAttribute('hidden', hasProject);
        }
        if (editButton) {
          editButton.disabled = !hasProject;
        }
        if (infoToggle) {
          infoToggle.disabled = !hasProject;
        }
      };

      const showWelcomeMessage = () => {
        const banner = document.getElementById('welcomeBanner');
        if (!banner) { return; }
        let welcomeName = '';
        try {
          if (window.sessionStorage) {
            welcomeName = window.sessionStorage.getItem(WELCOME_KEY) || '';
          }
        } catch (error) {
          welcomeName = '';
        }

        if (welcomeName) {
          banner.textContent = `Welcome ${welcomeName} you can now update the Project Dashboard`;
          banner.classList.add('active');
          banner.removeAttribute('hidden');
          try {
            window.sessionStorage && window.sessionStorage.removeItem(WELCOME_KEY);
          } catch (error) {
            // ignore storage removal issues
          }
        } else {
          banner.classList.remove('active');
          banner.setAttribute('hidden', '');
          banner.textContent = '';
        }
      };

      const renderActiveUserMessage = () => {
        const banner = document.getElementById('activeUserMessage');
        if (!banner) { return; }
        const username = getActiveUserName() || 'User';
        banner.textContent = `${username} - Project Dashboard`;
      };
      
      // Make it globally accessible for auth state change
      window.renderActiveUserMessage = renderActiveUserMessage;

      const syncProjectSelect = (activeProject) => {
        const select = document.getElementById('projectSelect');
        if (!select) { return; }
        const searchTerm = (document.getElementById('projectSearchInput')?.value || '').trim().toLowerCase();
        const statusFilter = document.getElementById('projectFilterStatus')?.value || 'all';
        const allProjs = listProjects(state);
        const projects = allProjs.filter((project) => {
          const pStatus = project.status || (isProjectCompleted(project) ? 'completed' : 'in_progress');
          if (statusFilter === 'all') {
            if (isProjectCompleted(project) && pStatus === 'completed') return false;
          } else if (pStatus !== statusFilter) {
            return false;
          }
          if (searchTerm && !String(project.title || '').toLowerCase().includes(searchTerm)) {
            return false;
          }
          return true;
        });

        const countEl = document.getElementById('projectFilterCount');
        if (countEl) {
          countEl.textContent = `${projects.length} matching project${projects.length === 1 ? '' : 's'}`;
        }

        if (!projects.length) {
          select.innerHTML = '<option value="" disabled>No matching projects available</option>';
          select.value = '';
          select.disabled = true;
          return;
        }
        select.disabled = false;
        select.innerHTML = projects
          .map((project) => `<option value="${project.id}">${project.title} [${(project.status || 'in_progress').replace('_', ' ').toUpperCase()}]</option>`)
          .join('');
        if (activeProject && projects.some(p => p.id === activeProject.id)) {
          select.value = activeProject.id;
        } else {
          select.value = projects[0].id;
        }
      };


      // Cards for user-defined custom sections, built to match the static section cards above
      const CUSTOM_CARD_ICON = '<svg viewBox="0 0 24 24"><path d="M4 4h7v7H4V4zm9 0h7v7h-7V4zM4 13h7v7H4v-7zm9 3h3v-3h2v3h3v2h-3v3h-2v-3h-3v-2z"/></svg>';
      const renderCustomSectionCards = () => {
        const grid = document.getElementById('cards');
        if (!grid) { return; }
        const customKeys = SECTION_ORDER.filter((key) => isCustomSection(key));
        grid.querySelectorAll('[data-custom-card]').forEach((card) => {
          if (!customKeys.includes(card.getAttribute('data-key'))) { card.remove(); }
        });
        customKeys.forEach((key) => {
          const def = SECTION_DEFS[key];
          let card = grid.querySelector(`[data-key="${key}"]`);
          if (!card) {
            card = document.createElement('article');
            card.className = 'card';
            card.setAttribute('data-key', key);
            card.setAttribute('data-custom-card', 'true');
            card.innerHTML = `
        <header>
          <div class="card-title-wrap">
            <div class="card-icon card-icon--${key}" aria-hidden="true">${CUSTOM_CARD_ICON}</div>
            <div class="title"></div>
          </div>
          <div class="status" id="status-${key}">—</div>
        </header>
        <div class="meta">
          <span data-f="lead"></span>
          <span data-f="scope"></span>
        </div>
        <div class="progress-wrap">
          <div class="progress-value">
            <span class="label">Completeness</span>
            <span class="percent" id="percent-${key}">0%</span>
          </div>
          <div class="progress-bar">
            <div class="progress-fill" id="bar-${key}"></div>
          </div>
        </div>
        <div class="controls single">
          <button class="btn secondary" data-open="${key}">Open Section</button>
        </div>
        <div class="footnote"></div>`;
            grid.appendChild(card);
          }
          // User-entered text is set with textContent
          card.querySelector('.title').textContent = def.title;
          card.querySelector('[data-f="lead"]').textContent = `Lead: ${def.lead || '—'}`;
          card.querySelector('[data-f="scope"]').textContent = `Scope: ${def.scope || '—'}`;
          card.querySelector('.progress-bar').setAttribute('aria-label', `${def.title} progress`);
          card.querySelector('.footnote').textContent = def.summary || '';
        });
      };

      const render = () => {
        renderCustomSectionCards();
        const project = currentProject();
        const hasProject = Boolean(project);
        toggleEmptyState(hasProject);
        const selectionFilter = computeSelectionFilter();
        if (!project) {
          const titleEl = document.getElementById('projectTitle');
          if (titleEl) { titleEl.textContent = 'No active project'; }
          const lastUpdateEl = document.getElementById('lastUpdate');
          if (lastUpdateEl) { lastUpdateEl.textContent = '—'; }
          const input = document.getElementById('titleInput');
          if (input && !isEditingTitle) {
            input.value = '';
          }
          renderInfoMenu(null, selectionFilter);
          applyTitleEditorState();
          syncProjectSelect(null);
          return;
        }
        SECTION_ORDER.forEach((key) => {
          const card = document.querySelector(`[data-key="${key}"]`);
          const enabled = isSectionEnabled(project, key);
          const selectionAllowed = !selectionFilter || selectionFilter.has(key);
          const showCard = enabled && selectionAllowed;

          if (card) {
            if (showCard) {
              card.removeAttribute('hidden');
              card.setAttribute('aria-hidden', 'false');
            } else {
              card.setAttribute('hidden', '');
              card.setAttribute('aria-hidden', 'true');
            }
          }

          if (!showCard) { return; }

          const section = project.sections[key];
          const pct = getSectionPercent(section);

          const bar = document.getElementById(`bar-${key}`);
          const label = document.getElementById(`percent-${key}`);
          const status = document.getElementById(`status-${key}`);

          if (bar) { bar.style.width = pct + '%'; }
          if (label) { label.textContent = pct + '%'; }
          if (status) {
            const st = statusClass(pct);
            status.textContent = st.text;
            status.classList.remove('ontrack', 'atrisk', 'delayed');
            status.classList.add(st.cls);
          }

          const footnote = card ? card.querySelector('.footnote') : null;
          if (footnote && section && section.summary) {
            footnote.textContent = section.summary;
          }
        });

        const lastUpdateEl = document.getElementById('lastUpdate');
        if (lastUpdateEl) {
          lastUpdateEl.textContent = fmtDate(new Date(project.lastUpdate));
        }

        const titleEl = document.getElementById('projectTitle');
        if (titleEl) { titleEl.textContent = project.title; }

        const statusSelect = document.getElementById('projectStatusSelect');
        if (statusSelect) {
          statusSelect.value = project.status || (isProjectCompleted(project) ? 'completed' : 'in_progress');
        }

        const input = document.getElementById('titleInput');
        if (input && !isEditingTitle) {
          input.value = project.title;
        }

        applyTitleEditorState();

        renderInfoMenu(project, selectionFilter);
        syncProjectSelect(project);
      };

      const saveAndRender = async () => {
        console.log('💾 saveAndRender called');
        try {
          await persistProjectState(state);
          console.log('✅ State persisted successfully');
        } catch (error) {
          console.error('❌ Failed to persist state:', error);
        }
        render();
      };

      const wire = () => {
        const editTitleBtn = document.getElementById('editTitleBtn');
        if (editTitleBtn) {
          editTitleBtn.addEventListener('click', (event) => {
            event.preventDefault();
            if (isEditingTitle) {
              closeTitleEditor();
            } else {
              openTitleEditor();
            }
          });
        }

        const titleForm = document.getElementById('titleForm');
        if (titleForm) {
          titleForm.addEventListener('submit', async (event) => {
            event.preventDefault();
            if (!ensureAuthenticated()) { return; }
            const input = document.getElementById('titleInput');
            if (!input) { return; }
            const value = input.value.trim();
            if (!value) {
              alert('Please enter a project title.');
              return;
            }
            const project = currentProject();
            if (!project) { return; }
            project.title = value;
            touchProject(project);
            closeTitleEditor();
            await saveAndRender();
          });
        }

        const cancelTitleEdit = document.getElementById('cancelTitleEdit');
        if (cancelTitleEdit) {
          cancelTitleEdit.addEventListener('click', (event) => {
            event.preventDefault();
            closeTitleEditor();
          });
        }

        document.querySelectorAll('[data-open]').forEach((button) => {
          button.addEventListener('click', () => {
            const key = button.getAttribute('data-open');
            const project = currentProject();
            if (!project) {
              alert('All saved projects are complete. Create a new project to keep editing sections.');
              return;
            }
            const section = project.sections[key];
            const route = SECTION_MANAGER_ROUTES[key] || section?.file || `${key}.html`;
            window.location.href = route;
          });
        });

        const toggle = document.getElementById('projectInfoToggle');
        const menu = document.getElementById('projectInfoMenu');

        const closeMenu = () => {
          if (!menu) { return; }
          if (!menu.hasAttribute('hidden')) {
            menu.setAttribute('hidden', '');
          }
          if (toggle) {
            toggle.setAttribute('aria-expanded', 'false');
          }
        };

        if (toggle && menu) {
          toggle.addEventListener('click', (event) => {
            event.stopPropagation();
            if (menu.hasAttribute('hidden')) {
              menu.removeAttribute('hidden');
              toggle.setAttribute('aria-expanded', 'true');
            } else {
              closeMenu();
            }
          });

          menu.addEventListener('click', (event) => event.stopPropagation());
          document.addEventListener('click', closeMenu);
        }

        if (menu) {
          menu.addEventListener('click', (event) => {
            const target = event.target.closest('[data-route]');
            if (!target) { return; }
            event.preventDefault();
            const route = target.getAttribute('data-route');
            closeMenu();
            if (route) {
              window.location.href = route;
            }
          });
        }

        const projectSelect = document.getElementById('projectSelect');
        if (projectSelect) {
          projectSelect.addEventListener('change', async () => {
            if (projectSelect.disabled) { return; }
            setActiveProject(state, projectSelect.value);
            closeTitleEditor();
            await saveAndRender();
          });
        }

        const createProjectBtn = document.getElementById('createProject');
        if (createProjectBtn) {
          createProjectBtn.addEventListener('click', async () => {
            try {
              console.log('🔵 Create Project button clicked');
              
              console.log('🔍 Checking authentication...');
              if (!ensureAuthenticated()) { 
                console.log('❌ Authentication check failed');
                return; 
              }
              console.log('✅ Authentication check passed');
              
              const input = document.getElementById('newProjectInput');
              if (!input) { 
                console.log('❌ Input element not found');
                return; 
              }
              
              const value = input.value.trim();
              console.log('📝 Project title:', value);
              
              if (!value) {
                console.log('⚠️ No project title entered');
                alert('Please enter a project title to save.');
                return;
              }
              
              const pendingSections = getPendingSectionSelection();
              console.log('📋 Pending sections:', pendingSections);
              
              if (!pendingSections.length) {
                console.log('⚠️ No sections selected');
                alert('Select at least one section before creating a project.');
                return;
              }
              
              const template = currentProject();
              console.log('📄 Template project:', template);
              
              console.log('🚀 Adding project to state...');
              addProject(state, value, template, pendingSections);
              console.log('✅ Project added to state:', state.activeProjectId);
              
              const username = getActiveUserName() || 'Unknown user';
              console.log('👤 Username:', username);
              
              console.log('📝 Appending update log...');
              appendUpdateLog({
                action: 'project-created',
                user: username,
                project: value
              });
              
              input.value = '';
              console.log('💾 Saving and rendering...');
              await saveAndRender();
              console.log('✅ Project creation complete!');
              console.log('Active project:', state.activeProjectId);
              console.log('Total projects:', Object.keys(state.projects).length);
              
            } catch (error) {
              console.error('❌ Error creating project:', error);
              console.error('Error stack:', error.stack);
              alert('Failed to create project. Check console for details.');
            }
          });
        }

        const pickerToggle = document.getElementById('sectionPickerToggle');
        if (pickerToggle) {
          pickerToggle.addEventListener('click', (event) => {
            event.preventDefault();
            toggleSectionPicker();
          });
        }

        const closePickerBtn = document.getElementById('closeSectionPicker');
        if (closePickerBtn) {
          closePickerBtn.addEventListener('click', () => {
            closeSectionPicker();
          });
        }

        const resetPickerBtn = document.getElementById('resetSections');
        if (resetPickerBtn) {
          resetPickerBtn.addEventListener('click', () => {
            selectedSections = getBaseSectionKeys();
            renderSectionPicker();
            render();
          });
        }

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            closeSectionPicker();
            if (isEditingTitle) {
              closeTitleEditor();
            }
          }
        });

        const backToOverviewBtn = document.getElementById('backToOverview');
        if (backToOverviewBtn) {
          backToOverviewBtn.addEventListener('click', () => {
            window.location.href = 'index.html';
          });
        }

        const logoutBtn = document.getElementById('logoutBtn');
        if (logoutBtn) {
          logoutBtn.addEventListener('click', async () => {
            try {
              window.ProjectData.logout();
              window.location.href = 'login.html';
            } catch (error) {
              console.error('Logout error:', error);
              alert('Failed to logout. Please try again.');
            }
          });
        }

        const viewLogsBtn = document.getElementById('viewLogs');
        if (viewLogsBtn) {
          viewLogsBtn.addEventListener('click', () => {
            window.location.href = 'user_update_logs.html';
          });
        }

        const modifyProjectBtn = document.getElementById('modifyProject');
        if (modifyProjectBtn) {
          modifyProjectBtn.addEventListener('click', () => {
            if (!ensureAuthenticated()) { return; }
            window.location.href = 'delete_project.html';
          });
        }

        const customSectionsBtn = document.getElementById('customSectionsBtn');
        if (customSectionsBtn) {
          customSectionsBtn.addEventListener('click', () => {
            if (!ensureAuthenticated()) { return; }
            window.location.href = 'custom_sections.html';
          });
        }
        const createGanttBtn = document.getElementById('createGanttChart');
        if (createGanttBtn) {
          createGanttBtn.addEventListener('click', () => {
            if (!ensureAuthenticated()) { return; }
            const proj = currentProject();
            window.location.href = proj ? `gantt_chart_creator.html?project_id=${encodeURIComponent(proj.id)}` : 'gantt_chart_creator.html';
          });
        }

        const statusSelect = document.getElementById('projectStatusSelect');
        if (statusSelect) {
          statusSelect.addEventListener('change', async () => {
            if (!ensureAuthenticated()) { return; }
            const project = currentProject();
            if (!project) { return; }
            project.status = statusSelect.value;
            touchProject(project, { preserveStatus: true });
            try {
              const headers = { 'Content-Type': 'application/json' };
              const apiKey = window.ProjectData.getApiKey && window.ProjectData.getApiKey();
              const token = window.ProjectData.getSessionToken && window.ProjectData.getSessionToken();
              if (apiKey) headers['X-API-Key'] = apiKey;
              if (token) headers['Authorization'] = `Bearer ${token}`;
              await fetch(`api/projects/${encodeURIComponent(project.id)}`, {
                method: 'PATCH',
                headers,
                body: JSON.stringify({ status: statusSelect.value })
              });
              if (window.ProjectData.showToast) {
                window.ProjectData.showToast(`Project status updated to ${statusSelect.value.replace('_', ' ')}`, 'success');
              }
            } catch (_) {}
            await saveAndRender();
          });
        }

        const searchInput = document.getElementById('projectSearchInput');
        if (searchInput) {
          searchInput.addEventListener('input', () => syncProjectSelect(currentProject()));
        }

        const filterStatus = document.getElementById('projectFilterStatus');
        if (filterStatus) {
          filterStatus.addEventListener('change', () => syncProjectSelect(currentProject()));
        }

        const changePwdBtn = document.getElementById('changePasswordBtn');
        if (changePwdBtn) {
          changePwdBtn.addEventListener('click', () => {
            if (window.ProjectData && window.ProjectData.openChangePasswordModal) {
              window.ProjectData.openChangePasswordModal();
            }
          });
        }

        const adminPortalBtn = document.getElementById('adminPortalBtn');
        if (adminPortalBtn) {
          if (window.ProjectData && window.ProjectData.isAdmin && window.ProjectData.isAdmin()) {
            adminPortalBtn.removeAttribute('hidden');
          }
          adminPortalBtn.addEventListener('click', () => {
            window.location.href = 'admin_dashboard.html';
          });
        }

        const completedProjectsBtn = document.getElementById('viewCompletedProjects');
        if (completedProjectsBtn) {
          completedProjectsBtn.addEventListener('click', () => {
            window.location.href = 'completed_project.html';
          });
        }

        const emptyStateCompletedBtn = document.getElementById('emptyCompletedProjects');
        if (emptyStateCompletedBtn) {
          emptyStateCompletedBtn.addEventListener('click', () => {
            window.location.href = 'completed_project.html';
          });
        }

        renderSectionPicker();
        closeSectionPicker();
      };

      const updatePageTime = () => {
        const timeEl = document.getElementById('pageTime');
        if (!timeEl) { return; }
        const now = new Date();
        const formatted = now.toLocaleString(undefined, {
          weekday: 'long',
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          hour: '2-digit',
          minute: '2-digit'
        });
        timeEl.textContent = `Today is ${formatted}`;
      };

      (async function() {
        state = await loadProjectState();
        selectedSections = getBaseSectionKeys();
        render();
        wire();
        showWelcomeMessage();
        renderActiveUserMessage();
        updatePageTime();
        setInterval(updatePageTime, 60000);
        window.pageLoaded = true;
      })();
    })();
  </script>
</body>

